Falsifies `clock_contract::verification::the_request_word_and_the_offset_round_trip`.

The defect: `propose::operation` shifts one bit too few, so the opcode comes back doubled.

Expected to fail: the harness's `assert!(propose::operation(propose::request(opcode)) == opcode)`.

diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -468,7 +468,7 @@
     /// The opcode of a request word. The low 56 bits are the request's to use, and nothing says
     /// they are zero, so this discards them.
     pub const fn operation(word: u64) -> u64 {
-        word >> OPERATION_SHIFT
+        word >> (OPERATION_SHIFT - 1)
     }
 
